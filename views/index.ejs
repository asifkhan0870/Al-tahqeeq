<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main">

<% if (result.page === 1) { %>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">

      <p class="basmala" lang="ar">
        بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
      </p>

      <h1 class="hero-title">
        <%= siteTitle %>
      </h1>

      <p class="hero-tagline">
        <%= siteTagline %>
      </p>

    </div>
  </section>


  <!-- Daily Quran & Hadith -->
  <% if (daily) { %>

  <section
    class="container daily-section"
    aria-labelledby="daily-h"
  >

    <!-- Date -->
    <div class="daily-date">

      <div class="daily-date-main">

        <span class="daily-calendar-icon">
          ◷
        </span>

        <span>
          <%= daily.date %>
        </span>

      </div>

      <div class="daily-hijri">
        <%= daily.hijri %>
      </div>

    </div>


    <!-- Quran + Hadith -->
    <div class="daily-grid">


      <!-- ========================================= -->
      <!-- QURAN -->
      <!-- ========================================= -->

      <article class="daily-card daily-quran">

        <!-- Quran Heading -->
        <div class="daily-card-header">

          <h2 id="daily-h">
            آج کی آیت
          </h2>

        </div>


        <!-- Bismillah -->
        <p
          class="basmala daily-bismillah"
          lang="ar"
          dir="rtl"
          style="
            text-align: center;
            margin: 0.15rem 0 1rem;
            font-size: 1.45rem;
            line-height: 2;
          "
        >
          بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
        </p>


        <!-- Arabic Quran Ayah -->
        <div
          class="daily-arabic"
          lang="ar"
          dir="rtl"
        >
          <%= daily.ayah.arabic %>
        </div>


        <!-- Urdu Translation -->
        <% if (daily.ayah.urdu) { %>

          <div
            class="daily-urdu"
            lang="ur"
            dir="rtl"
          >
            <%= daily.ayah.urdu %>
          </div>

        <% } %>


        <!-- Quran Reference -->
        <div class="daily-reference">
          <%= daily.ayah.reference %>
        </div>

      </article>



      <!-- ========================================= -->
      <!-- HADITH -->
      <!-- ========================================= -->

      <article class="daily-card daily-hadith">

        <!-- Hadith Heading -->
        <div class="daily-card-header">

          <span class="daily-icon">
            ﷺ
          </span>

          <h2>
            آج کی حدیث
          </h2>

        </div>


        <!-- Arabic Hadith -->
        <div
          class="daily-arabic"
          lang="ar"
          dir="rtl"
        >
          <%= daily.hadith.arabic %>
        </div>


        <!-- Urdu Translation -->
        <% if (daily.hadith.urdu) { %>

          <div
            class="daily-urdu"
            lang="ur"
            dir="rtl"
          >
            <%= daily.hadith.urdu %>
          </div>

        <% } %>


        <!-- Hadith Reference -->
        <div class="daily-reference">
          <%= daily.hadith.reference %>
        </div>

      </article>

    </div>

  </section>

  <% } %>



  <!-- ========================================= -->
  <!-- TOPICS -->
  <!-- ========================================= -->

  <section
    class="container topics"
    aria-labelledby="topics-h"
  >

    <h2
      id="topics-h"
      class="block-title"
    >
      موضوعات
    </h2>


    <ul class="topic-list">

      <% sections.forEach(function(s){ %>

        <li style="--c: <%= s.color %>">

          <a href="/section/<%= s.slug %>">

            <span class="topic-name">

              <%= s.nav %>

              <small dir="ltr">
                <%= s.sub %>
              </small>

            </span>


            <span class="topic-desc">
              <%= s.desc %>
            </span>


            <span class="topic-count">
              <%= counts[s.slug] || 0 %> تحریریں
            </span>

          </a>

        </li>

      <% }) %>

    </ul>

  </section>

<% } %>



<!-- ========================================= -->
<!-- LATEST POSTS -->
<!-- ========================================= -->

<section
  class="container latest"
  aria-labelledby="latest-h"
>

  <h2
    id="latest-h"
    class="block-title"
  >
    تازہ تحریریں
  </h2>


  <% if (!result.rows.length) { %>

    <div class="empty">

      <p>
        ابھی کوئی تحریر شائع نہیں ہوئی۔
      </p>


      <% if (isAdmin) { %>

        <p dir="ltr">

          <a
            class="btn btn-primary"
            href="<%= adminBase %>/posts/new"
          >
            Write your first post
          </a>

        </p>

      <% } %>

    </div>


  <% } else { %>


    <div class="entries">

      <% result.rows.forEach(function(p){ %>

        <%- include('partials/entry', { p: p }) %>

      <% }) %>

    </div>


    <%- include('partials/pagination') %>


  <% } %>

</section>

</main>


<%- include('partials/footer') %>