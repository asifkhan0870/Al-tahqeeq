<a class="skip" href="#main">مواد پر جائیں</a>

<header class="masthead">

  <div class="masthead-bar container">

    <!-- Left side -->
    <div class="bar-start">

      <!-- Mobile Menu -->
      <button
        type="button"
        class="icon-btn menu-btn"
        id="menu-btn"
        aria-label="مینو"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>


      <!-- Desktop Search -->
      <form
        class="search search-desktop"
        action="/search"
        method="get"
        role="search"
      >

        <input
          type="search"
          name="q"
          placeholder="تلاش کریں…"
          aria-label="تلاش"
          maxlength="100"
          value="<%= locals.q || '' %>"
        >

        <button
          type="submit"
          aria-label="تلاش کریں"
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="6.5"/>
            <path d="M16 16l4.5 4.5"/>
          </svg>
        </button>

      </form>

    </div>


    <!-- ===================================== -->
    <!-- WEBSITE TITLE -->
    <!-- ===================================== -->

    <a
      class="brand"
      href="/"
      style="
        font-family: arbMushafFont, serif;
        font-weight: normal;
        letter-spacing: 0;
      "
    >
      <%= siteTitle %>
    </a>


    <!-- Right side -->
    <div class="bar-end">

      <% if (isAdmin) { %>

        <a
          class="admin-pill"
          href="<%= adminBase %>"
          dir="ltr"
        >
          Admin
        </a>

      <% } %>


      <!-- Theme Toggle -->
      <%- include('theme-toggle') %>

    </div>

  </div>


  <!-- ===================================== -->
  <!-- NAVIGATION -->
  <!-- ===================================== -->

  <nav
    class="sections"
    id="site-nav"
    aria-label="موضوعات"
  >

    <!-- Mobile Search -->
    <form
      class="search search-mobile"
      action="/search"
      method="get"
      role="search"
    >

      <input
        type="search"
        name="q"
        placeholder="تلاش کریں…"
        aria-label="تلاش"
        maxlength="100"
      >

      <button
        type="submit"
        aria-label="تلاش کریں"
      >

        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="6.5"/>
          <path d="M16 16l4.5 4.5"/>
        </svg>

      </button>

    </form>


    <!-- Navigation Sections -->
    <ul class="container">

      <% sections.forEach(function(s) {
        var active =
          currentPath === '/section/' + s.slug ||
          (locals.section && locals.section.slug === s.slug);
      %>

        <li style="--c: <%= s.color %>">

          <a
            href="/section/<%= s.slug %>"
            <% if (active) { %>
              aria-current="page"
            <% } %>
          >

            <span class="nav-main">
              <%= s.nav %>
            </span>

            <span
              class="nav-sub"
              dir="ltr"
            >
              <%= s.sub %>
            </span>

          </a>

        </li>

      <% }) %>

    </ul>

  </nav>

</header>