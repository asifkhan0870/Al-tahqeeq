<!doctype html>
<html lang="<%= htmlLang %>" dir="<%= htmlDir %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= pageTitle ? pageTitle + ' | ' + siteTitle : siteTitle %></title>
<meta name="description" content="<%= description || siteTagline %>">
<% if (robotsNoindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
<% if (canonical) { %><link rel="canonical" href="<%= siteUrl + encodeURI(canonical) %>"><% } %>
<meta property="og:site_name" content="<%= siteTitle %>">
<meta property="og:type" content="<%= ogType %>">
<meta property="og:title" content="<%= pageTitle || siteTitle %>">
<meta property="og:description" content="<%= description || siteTagline %>">
<% if (ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>
<meta name="theme-color" content="#1D3F8C">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<script src="<%= asset('/js/theme-init.js') %>"></script>
<% if (bodyClass === 'admin') { %><link rel="stylesheet" href="<%= asset('/vendor/quill/quill.snow.css') %>"><% } %>
<link rel="stylesheet" href="<%= asset('/css/style.css') %>">
<% if (bodyClass === 'admin') { %><link rel="stylesheet" href="<%= asset('/css/admin.css') %>"><% } %>
</head>
<body class="<%= bodyClass %>">
