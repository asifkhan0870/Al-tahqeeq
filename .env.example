# ===========================================================================
#  Copy this file to ".env" and fill in your own values.
#  NEVER upload the real ".env" file to GitHub or share it with anyone.
# ===========================================================================

# 1) Your PostgreSQL database link (see README, step 3).
#    Format:  postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
#    Local example:   postgresql://postgres:mypassword@localhost:5432/urduarabicblog
#    Neon / Supabase / Render: copy the "connection string" they give you.
DATABASE_URL=postgresql://postgres:mypassword@localhost:5432/urduarabicblog

# 2) The password you will type on the admin login page. Make it long and private.
ADMIN_PASSWORD=your-strong-password-here

# 3) A long random text used to protect your login. Generate one with:  npm run gen-secret
JWT_SECRET=paste-the-generated-secret-here-at-least-32-characters

# 4) The public address of your website (no slash at the end).
#    While testing on your computer use http://localhost:3000
SITE_URL=http://localhost:3000

# 5) Site name and one-line description (Urdu is fine).
SITE_TITLE= مکالمہ  
SITE_TAGLINE=قرآن، حدیث اور فکری مباحث پر تحقیقی تحریریں

# ---------------------------------------------------------------------------
#  Optional settings (you can leave these as they are)
# ---------------------------------------------------------------------------
PORT=3000

# Web address of the admin panel. Change it (for example /panel-x7k2) if you
# want to hide it from strangers. Do not put a slash at the end.
ADMIN_PATH=/admin

# Set to "production" when the site is online (turns on secure cookies, caching).
NODE_ENV=development

# Only needed if a cloud database refuses the connection with an SSL error:
# DATABASE_SSL=true

# If you run in production but test over plain http://localhost, set this to false:
# COOKIE_SECURE=false
